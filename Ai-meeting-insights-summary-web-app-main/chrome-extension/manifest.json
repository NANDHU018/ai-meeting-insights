{
  "manifest_version": 3,
  "name": "AI Meeting Assistant Recorder",
  "version": "1.1",
  "description": "Auto-detects Google Meet & Zoom, records tab audio, and uploads to AI Meeting Assistant.",
  "permissions": [
    "tabCapture",
    "storage",
    "activeTab",
    "offscreen",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*",
    "http://127.0.0.1:5173/*",
    "http://localhost:5173/*",
    "https://meet.google.com/*",
    "https://*.zoom.us/*"
  ],
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Meeting Recorder",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:5000/*",
        "http://localhost:5000/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  }
}
